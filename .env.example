# Nortus - Variáveis de Ambiente

# URL base da API
NEXT_PUBLIC_API_URL=https://loomi.s3.us-east-1.amazonaws.com/mock-api-json/v2

# Ambiente
NODE_ENV=development

# Configurações de cookies
NEXT_PUBLIC_COOKIE_DOMAIN=localhost
NEXT_PUBLIC_COOKIE_SECURE=false

# Telemetria Next.js (opcional)
NEXT_TELEMETRY_DISABLED=1
